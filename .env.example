PORT=3000
NODE_ENV=development

DATABASE_HOST=localhost
DATABASE_PORT=5434
DATABASE_USER=nexara
DATABASE_PASSWORD=nexara
DATABASE_NAME=nexara
DATABASE_SYNC=true
DATABASE_SSL=false

FINERACT_BASE_URL=https://localhost:8443/fineract-provider/api/v1
FINERACT_TENANT_ID=default
FINERACT_USERNAME=nexara-api
FINERACT_PASSWORD="NexaraApi#2026Dev"
FINERACT_TLS_INSECURE=true
FINERACT_OFFICE_ID=1
FINERACT_SAVINGS_PRODUCT_ID=3
FINERACT_CLIENT_TYPE_ID=23
FINERACT_LEGAL_FORM_ID=2
FINERACT_PT_WALLET_FUNDING=4
FINERACT_PT_PAYOUT=5
FINERACT_PT_PAYOUT_FEE=6
FINERACT_PT_GST=7
FINERACT_PT_REVERSAL=8
FINERACT_PT_MANUAL_ADJUSTMENT=9

KYC_PROVIDER=mock
DIGILOCKER_BASE_URL=
DIGILOCKER_CLIENT_ID=
DIGILOCKER_CLIENT_SECRET=

# Seeds the first platform default bank only (mock -> MOCK, yesbank -> YESBANK).
# After boot, switch rails with PUT /v1/ops/banks/default.
BANK_PROVIDER=mock
YESBANK_BASE_URL=
YESBANK_CLIENT_ID=
YESBANK_CLIENT_SECRET=

# Object storage for KYC images (selfie / Aadhaar / PAN scans).
# Use STORAGE_DRIVER=local for disk uploads/ during local dev without S3.
STORAGE_DRIVER=s3
AWS_REGION=ap-south-1
S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Optional: custom endpoint (LocalStack / MinIO), public CDN/base URL, path-style
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=false
S3_PUBLIC_BASE_URL=

# Optional: override Razorpay IFSC lookup URL used by POST /v1/me/beneficiaries/ifsc-lookup
BANK_IFSC_LOOKUP_URL=https://ifsc.razorpay.com

JWT_SECRET=nexara-dev-jwt-secret
AUTH_ADMIN_EMAIL=admin@nexara.com
AUTH_OPS_EMAIL=ops@nexara.com
AUTH_ADMIN_PASSWORD="NexaraAdmin#2026"
AUTH_MERCHANT_DEFAULT_PASSWORD="ChangeMe#2026"
AUTH_OTP_CODE=123456
